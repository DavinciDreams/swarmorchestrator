{
  "name": "swarm-orchestrator",
  "version": "1.0.0",
  "description": "Deep Agent orchestrator for coordinating agent swarms with pluggable execution backends",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "daemon": "tsx src/daemon.ts",
    "daemon:start": "tsx src/daemon.ts start",
    "daemon:status": "tsx src/daemon.ts status",
    "worker:audit": "tsx src/daemon.ts run audit",
    "worker:map": "tsx src/daemon.ts run map",
    "worker:optimize": "tsx src/daemon.ts run optimize",
    "worker:testgaps": "tsx src/daemon.ts run testgaps",
    "queue:status": "tsx scripts/manage-queue.ts status",
    "queue:clean": "tsx scripts/manage-queue.ts clean",
    "queue:prune": "tsx scripts/manage-queue.ts prune"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.30"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.15",
    "@langchain/core": "^1.1.19",
    "@langchain/langgraph": "^1.1.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/openai": "^1.2.5",
    "deepagents": "^1.6.1",
    "dotenv": "^16.4.7",
    "langchain": "^1.2.18",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
