# ──────────────────────────────────────────────
# Provider selection
# ──────────────────────────────────────────────
# Options: zai | openrouter | anthropic | openai
LLM_PROVIDER=zai

# If primary provider fails (missing key, auth error), try this one
LLM_FALLBACK_PROVIDER=openrouter

# ──────────────────────────────────────────────
# z.ai  (OpenAI-compatible)
# ──────────────────────────────────────────────
ZAI_API_KEY=your-zai-key
ZAI_BASE_URL=https://api.z.ai/v1
ZAI_MODEL=glm-4.7

# ──────────────────────────────────────────────
# OpenRouter  (OpenAI-compatible, 200+ models)
# https://openrouter.ai/keys
# ──────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ──────────────────────────────────────────────
# Anthropic  (direct SDK — supports API key or OAuth)
# ──────────────────────────────────────────────
# Use ONE of the following:
# ANTHROPIC_API_KEY=sk-ant-...          # static API key
# ANTHROPIC_AUTH_TOKEN=your-oauth-token # OAuth bearer token (takes precedence)

# ──────────────────────────────────────────────
# OpenAI  (or any OpenAI-compatible endpoint)
# ──────────────────────────────────────────────
# OPENAI_API_KEY=your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# ──────────────────────────────────────────────
# Claude Flow MCP
# ──────────────────────────────────────────────
CLAUDE_FLOW_MODE=v3
CLAUDE_FLOW_TOPOLOGY=hierarchical-mesh
CLAUDE_FLOW_MAX_AGENTS=8
CLAUDE_FLOW_MEMORY_BACKEND=hybrid

# ──────────────────────────────────────────────
# Agent Coordinator Configuration
# ──────────────────────────────────────────────

# Iterative Refinement - Tasks are re-executed until quality threshold is met
ITERATIVE_REFINEMENT_ENABLED=true
MAX_ITERATIONS=1                    # Number of refinement iterations (default: 1)
QUALITY_THRESHOLD=0.8               # Quality score threshold 0-1 (default: 0.8)

# Historical Learning - Learn from past executions
HISTORICAL_LEARNING_ENABLED=true
RETRIEVAL_TOP_K=5                   # Number of similar past tasks to retrieve
PATTERN_MIN_SUCCESS_RATE=0.7        # Minimum success rate for pattern reuse

# Swarm Configuration - Override default swarm settings
SWARM_TOPOLOGY=hierarchical-mesh    # Options: mesh | hierarchical | hierarchical-mesh | ring | star | adaptive | hybrid
SWARM_MAX_AGENTS=8                  # Maximum agents per swarm
